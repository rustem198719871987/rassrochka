# Порт веб-сервера
PORT=3000
# Папка с базой данных SQLite (по умолчанию ./data)
DATA_DIR=./data
# Первый администратор (создаётся при первом запуске, если админа ещё нет)
ADMIN_PHONE=79990000000
ADMIN_PASSWORD=смените-этот-пароль
# Секрет cookie-сессий (если не задан — генерируется в DATA_DIR/session.secret)
SESSION_SECRET=
# Ключ шифрования файлов (64 hex-символа). Если не задан — создаётся data/files.key.
# Храните его копию отдельно от резервной копии данных.
FILES_KEY=
# Включите 1, когда сайт работает по HTTPS
COOKIE_SECURE=0
# Адрес сайта для QR-кода «фото паспорта с телефона», например https://rassrochka.top
# (если не задан — берётся из адреса, по которому открыт сайт)
PUBLIC_URL=
# off — не запускать фоновые задачи (напоминания и претензии)
JOBS=on

# SMS.ru — ключ API. Удобнее указать в админке: Настройки → SMS.ru.
# Без ключа SMS работают в тестовом режиме: код виден продавцу на экране.
SMS_RU_API_ID=
# Имя отправителя (должно быть согласовано в SMS.ru)
SMS_FROM=

# Yandex Vision OCR — полное распознавание паспорта и прописки (можно указать в админке).
# Без ключа работает встроенное распознавание машиночитаемой зоны паспорта.
YANDEX_VISION_API_KEY=
YANDEX_FOLDER_ID=

# Автоматическая проверка ФССП и БКИ через поставщика данных (см. lib/checks.js)
FSSP_API_URL=
FSSP_API_TOKEN=
BKI_API_URL=
BKI_API_TOKEN=
