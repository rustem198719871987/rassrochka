<% const CLAIM_PILL = { new: 'declined', handed: 'correction', delivered: 'draft', closed: 'approved' };
   const backVal = locals.compact ? 'card' : 'list'; %>
<div class="table-wrap">
  <table class="table">
    <thead><tr>
      <th>Претензия</th><% if (!locals.compact) { %><th>Клиент</th><% } %><th class="num">Долг</th><th>Просрочка</th><th>Статус</th><th></th>
    </tr></thead>
    <tbody>
      <% if (!rows.length) { %><tr><td colspan="6" class="empty">Претензий нет</td></tr><% } %>
      <% for (const c of rows) { %>
        <tr>
          <td class="nowrap"><a href="/app/claims/<%= c.id %>" target="_blank"><b><%= c.number %></b></a><div class="small muted"><%= date(c.created_at) %></div></td>
          <% if (!locals.compact) { %>
            <td><%= fio(c) %><div class="small muted"><a href="/app/<%= c.app_id %>"><%= c.app_number %></a> · <%= phone(c.phone) %></div></td>
          <% } %>
          <td class="num"><b><%= money(c.overdue_amount) %></b></td>
          <td class="nowrap"><%= c.overdue_days %> дн.</td>
          <td><span class="pill <%= CLAIM_PILL[c.status] %>"><%= CLAIM_STATUS[c.status] %></span>
            <% if (c.status === 'closed' && c.close_reason) { %><div class="small muted"><%= c.close_reason %></div><% } %></td>
          <td class="actions-cell">
            <div class="row-actions">
              <a class="btn btn-outline btn-sm" href="/app/claims/<%= c.id %>?print=1" target="_blank"><%- include('../partials/icon', { icon: 'print' }) %>Печать</a>
              <% if (c.status === 'new') { %>
                <form method="post" action="/app/claims/<%= c.id %>/handed"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="<%= backVal %>"><button class="btn btn-dark btn-sm" type="submit">Передана руководителю</button></form>
              <% } %>
              <% if (c.status === 'new' || c.status === 'handed') { %>
                <form method="post" action="/app/claims/<%= c.id %>/delivered"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="<%= backVal %>"><button class="btn btn-outline btn-sm" type="submit">Вручена клиенту</button></form>
              <% } %>
              <% if (user.role === 'admin' && c.status !== 'closed') { %>
                <form method="post" action="/admin/claims/<%= c.id %>/close" onsubmit="return confirm('Закрыть претензию?')"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="<%= backVal %>"><button class="link-btn" type="submit">Закрыть</button></form>
              <% } %>
            </div>
          </td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>
