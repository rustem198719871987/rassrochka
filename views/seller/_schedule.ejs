<%# График платежей. До подписания — план, после — с оплатами и днями до платежа %>
<% const PILL = { paid: 'approved', overdue: 'declined', today: 'correction', soon: 'draft', upcoming: '' }; %>
<div class="table-wrap">
  <table class="table">
    <thead><tr><th>№</th><th>Дата платежа</th><th class="num">Сумма</th><th class="num">Оплачено</th><th>Срок</th></tr></thead>
    <tbody>
      <% if (a.down_payment) { %>
        <tr><td>—</td><td>При подписании</td><td class="num"><%= money(a.down_payment) %></td><td class="num"><%= money(a.down_payment) %></td><td><span class="pill">Первый взнос</span></td></tr>
      <% } %>
      <% for (const p of schedule) { %>
        <tr>
          <td><%= p.n %></td>
          <td class="nowrap"><%= date(p.due_date) %></td>
          <td class="num"><b><%= money(p.amount) %></b></td>
          <td class="num"><%= p.id ? (p.paid_amount ? money(p.paid_amount) : '—') : '' %></td>
          <td>
            <% if (!p.id) { %><span class="pill">План</span>
            <% } else if (p.state === 'paid') { %><span class="pill approved">Оплачен <%= date(p.paid_at) %></span>
            <% } else { %>
              <span class="pill <%= PILL[p.state] %>"><%= daysLabel(p) %></span>
              <% if (p.partial) { %><div class="small muted">осталось <%= money(p.remaining) %></div><% } %>
            <% } %>
          </td>
        </tr>
      <% } %>
      <tr><td></td><td><b>Итого</b></td><td class="num"><b><%= money(a.total_amount) %></b></td><td class="num"><%= locals.paidTotal != null ? money(paidTotal + a.down_payment) : '' %></td><td></td></tr>
    </tbody>
  </table>
</div>
