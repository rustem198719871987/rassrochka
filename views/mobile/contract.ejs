<%- include('../partials/head') %>
<%- include('_top') %>
<style>
  .pages { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 14px; }
  .pg { background: var(--white); border-radius: 14px; padding: 8px; position: relative; }
  .pg canvas { width: 100%; height: auto; border-radius: 8px; display: block; background: #000; }
  .pg .no { position: absolute; top: 14px; left: 14px; background: var(--black); color: var(--yellow); font-weight: 800; font-size: 12px; border-radius: 20px; padding: 2px 8px; }
  .pg .row { display: flex; justify-content: space-between; margin-top: 6px; }
  .pg button { background: none; border: 0; font: inherit; font-weight: 700; font-size: 13px; padding: 6px; cursor: pointer; }
  .pg .del { color: var(--err); }
  .add { display: flex; align-items: center; justify-content: center; gap: 10px; border: 2px dashed #c9c9cf; border-radius: 14px; padding: 26px; font-weight: 800; cursor: pointer; background: var(--white); }
  .add svg { width: 26px; height: 26px; }
  .add input { display: none; }
</style>
<div class="m-wrap">
<% if (state !== 'ok') { %>
  <div class="center-card">
    <% if (state === 'sent') { %>
      <div class="big-ico" style="background:var(--ok-soft);color:var(--ok)">✓</div>
      <h1>Договор загружен</h1>
      <p class="muted">Страницы прикреплены к рассрочке. Их можно посмотреть в карточке заявки на компьютере.</p>
    <% } else { %>
      <div class="big-ico" style="background:var(--warn-soft);color:var(--warn)">!</div>
      <h1><%= state === 'expired' ? 'Ссылка устарела' : 'Ссылка недействительна' %></h1>
      <p class="muted">Нажмите на компьютере «Загрузить по QR-коду» ещё раз и отсканируйте новый код.</p>
    <% } %>
  </div>
<% } else { %>
  <div id="form-view">
    <h1>Скан подписанного договора</h1>
    <p class="muted" style="margin-top:0">Снимайте каждую страницу по очереди, сверху вниз, при хорошем свете. Страница должна целиком попасть в кадр, подписи — читаться.</p>
    <div class="pages" id="pages" data-limit="<%= maxPages %>"></div>
    <label class="add" id="add">
      <%- include('../partials/icon', { icon: 'camera' }) %>
      <span id="add-label">Сфотографировать страницу 1</span>
      <input type="file" accept="image/*" multiple id="file">
    </label>
    <div class="alert alert-error" id="err" style="display:none;margin-top:14px"></div>
  </div>
  <div id="done-view" class="center-card" style="display:none">
    <div class="big-ico" style="background:var(--ok-soft);color:var(--ok)">✓</div>
    <h1>Договор загружен</h1>
    <p class="muted" id="done-text">Страницы прикреплены к рассрочке.</p>
  </div>
  <div class="send-bar" id="send-bar">
    <button class="btn btn-primary btn-lg btn-block" id="send" disabled>Отправить</button>
  </div>
<% } %>
</div>
<% if (state === 'ok') { %>
<script src="/static/js/mobile-contract.js?v=<%= locals.v %>"></script>
<% } %>
</body>
</html>
