<%# Столбчатый график одного ряда. points: [{ short, long, value }], fmt — подпись значения, axisFmt — подпись оси %>
<%
  const W = 760, H = 250, padL = 58, padR = 12, padT = 24, padB = 30;
  const plotW = W - padL - padR, plotH = H - padT - padB;
  const max = Math.max(0, ...points.map((p) => p.value));
  const tk = ticks(max);
  const n = points.length;
  const slot = plotW / Math.max(n, 1);
  const barW = Math.max(3, Math.min(24, slot * 0.62));
  const y = (v) => padT + plotH * (1 - v / tk.top);
  const every = Math.ceil(n / 12);
  const maxIdx = points.findIndex((p) => p.value === max && max > 0);
%>
<div class="chart-wrap" data-chart data-h="<%= H %>">
  <% if (!max) { %>
    <div class="chart-empty">За выбранный период оформленных рассрочек нет</div>
  <% } else { %>
  <svg viewBox="0 0 <%= W %> <%= H %>" role="img" aria-label="<%= locals.title %>">
    <g class="grid axis">
      <% for (const v of tk.list) { %>
        <line x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= y(v) %>" y2="<%= y(v) %>"></line>
        <text x="<%= padL - 8 %>" y="<%= y(v) + 4 %>" text-anchor="end"><%= axisFmt(v) %></text>
      <% } %>
    </g>
    <line class="base" x1="<%= padL %>" x2="<%= W - padR %>" y1="<%= y(0) %>" y2="<%= y(0) %>"></line>
    <% points.forEach((pt, i) => {
         const cx = padL + slot * (i + 0.5), x0 = cx - barW / 2, x1 = cx + barW / 2;
         const top = y(pt.value), base = y(0), r = Math.min(4, barW / 2, base - top); %>
      <g class="bar" tabindex="0" data-value="<%= fmt(pt.value) %>" data-label="<%= pt.long %>" data-top="<%= top %>" aria-label="<%= pt.long %>: <%= fmt(pt.value) %>">
        <rect class="bar-hit" x="<%= cx - slot / 2 %>" y="<%= padT %>" width="<%= slot %>" height="<%= plotH %>"></rect>
        <% if (pt.value > 0) { %>
          <path d="M<%= x0 %>,<%= base %> L<%= x0 %>,<%= top + r %> Q<%= x0 %>,<%= top %> <%= x0 + r %>,<%= top %> L<%= x1 - r %>,<%= top %> Q<%= x1 %>,<%= top %> <%= x1 %>,<%= top + r %> L<%= x1 %>,<%= base %> Z"></path>
        <% } %>
        <% if (i === maxIdx) { %><text class="val" x="<%= cx %>" y="<%= top - 7 %>" text-anchor="middle"><%= fmt(pt.value) %></text><% } %>
      </g>
      <% if (i % every === 0) { %><text class="axis-x" x="<%= cx %>" y="<%= H - 10 %>" text-anchor="middle" fill="var(--muted)" font-size="11"><%= pt.short %></text><% } %>
    <% }) %>
  </svg>
  <div class="chart-tip" hidden></div>
  <% } %>
</div>
